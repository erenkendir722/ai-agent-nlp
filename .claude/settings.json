{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/git_kontrol.py baslangic 2>/dev/null || true",
            "timeout": 20,
            "statusMessage": "GitHub durumu kontrol ediliyor..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 tools/git_kontrol.py bitis 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
