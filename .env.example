# Örnek ortam yapılandırması. `cp .env.example .env` ile kopyalayın.
# GERÇEK SIR BU DOSYAYA YAZILMAZ — .env dosyası .gitignore'dadır.

# --- LLM SAĞLAYICI ---
# evren  : SSB EVREN servisi (8×H200, vLLM BF16). Ölçüm koşuları için.
# ollama : kurum içi yerel model. Hava boşluğu demosu ve servis düştüğünde yedek.
LLM_SAGLAYICI=evren

# --- EVREN (TEKNOFEST / SSB tahsisli) ---
EVREN_TEMEL_URL=https://evren-llmapi.ssyz.org.tr/v1
# llm-large = Qwen3.5-122B-A10B (MoE, Apache 2.0) — varsayılan, en yüksek doğruluk
# llm-fast  = Qwen3.6-35B-A3B  (MoE, Apache 2.0) — ölçümde şema geçerliliği daha düşük
EVREN_MODEL=llm-large
#
# ⚠️  ANAHTARI BU DOSYAYA YAZMAYIN — bu dosya depoya giriyor.
#     Takım anahtarını yalnız `.env` içine koyun:
#         EVREN_API_ANAHTARI=sk-evren-teamNN-...
EVREN_API_ANAHTARI=

# Eş zamanlı çıkarım işçisi. EVREN'de varsayılan 16, yerelde 1.
# Yerelde 1'den yükseltmeyin: tek makinede model ikinci kez belleğe yüklenir.
# CIKARIM_ISCI=16

# Modele verilen azami metin (karakter). EVREN'de 40000; yerel 4B ile 6000 yapın.
# AZAMI_METIN=40000

# --- QDRANT (TEKNOFEST / SSB tahsisli Vektör DB) ---
QDRANT_URL=https://qdrant.ssyz.org.tr
# QDRANT_API_ANAHTARI=sk-qdrant-...
QDRANT_API_ANAHTARI=

# --- YEREL LLM (yedek yol) ---
OLLAMA_HOST=http://127.0.0.1:11434
# Geliştirme (Profil B, 24 GB VRAM):   qwen3.5:9b-q4_K_M
# Laptop / fiziki final (Profil C):    qwen3.5:4b-q4_K_M
# Düşük bellek yedeği:                 qwen3.5:2b-q4_K_M
OLLAMA_MODEL=qwen3.5:4b-q4_K_M

# --- Veritabanı ---
# SQLite varsayılan. PostgreSQL'e geçiş yalnız bu satırın değişmesidir:
# VERITABANI_URL=postgresql+psycopg://kullanici:parola@sunucu:5432/katilim
VERITABANI_URL=sqlite:///data/katilim.db

# --- ON-PREM SERTLEŞTİRME (şartname 5.9) ---
# Bu değişkenler kütüphanelerin dışarıya çağrı yapmasını engeller.
# Bankacılık ortamında varsayılan telemetri kabul edilemez.
# NOT: Çıkarım LLM'i EVREN'e çıkar (SSB tahsisli, kurum dışı sayılmıyor).
# Karşılaştırma, chatbot ve kural katmanları hâlâ tamamen kapalı devredir —
# `tests/test_sizinti_yok.py` bunu ölçmeye devam ediyor.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
ANONYMIZED_TELEMETRY=False
DO_NOT_TRACK=1
STREAMLIT_BROWSER_GATHER_USAGE_STATS=false
