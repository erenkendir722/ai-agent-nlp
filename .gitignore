# Ortam
.venv/
__pycache__/
*.py[cod]
.env
.DS_Store

# Türetilmiş veri (yeniden üretilebilir)
data/katilim.db
# Ablasyon koşularının kendi veritabanları — türetilmiş, `make ablasyon` üretir
data/ablasyon/
# Ham anlık görüntülerin META VERİSİ repoda kalır (izlenebilirlik kanıtı),
# ham HTML dosyaları kalmaz (depo şişer + telif riski).
data/raw/**/*.html
# Çevrimdışı kurulum paketi (E-14) — yüzlerce MB tekerlek dosyası.
# `make paket` yeniden üretir; USB'ye elle kopyalanır, depoya girmez.
paketler/

data/embeddings.npy
# RAG vektör indeksi — 36 MB, türetilmiş. `make vektor` 70 sn'de yeniden kurar.
# ⚠️ Hava boşluğu demosunda (E-14) çevrimdışı pakete ELLE konmalı.
# NOT: data/vektor_indeksi.npz ARTIK TAKİPLİ (26 Ağu).
# Ağsız kurulabilmesi için depoda durması gerekiyor — gerekçe
# .gitattributes'ta ve docs/KURULUM.md «Hava boşluğu» bölümünde.

# Araç çıktıları
.pytest_cache/
.ruff_cache/
*.egg-info/

# Elle alınmış paylaşım kopyaları — data/gold/ zaten depoda,
# zip bayatlar ve iki ayrı gerçeklik doğar
data/*.zip

# Okuma kâğıtları CSV'den türetilir (`make altin-ornekle` otomatik üretir).
# Depoda tutulursa CSV düzeltildikçe bayatlar ve etiketleyen yanlış sayfaya
# bakar — aynı "iki ayrı gerçeklik" tuzağı.
data/gold/okuma_*.md
