# Ortam
.venv/
__pycache__/
*.py[cod]
.env
.DS_Store

# Türetilmiş veri (yeniden üretilebilir)
data/katilim.db
data/raw/**/*.html
data/embeddings.npy

# Ham anlık görüntülerin META VERİSİ repoda kalır (izlenebilirlik kanıtı),
# ham HTML dosyaları kalmaz (depo şişer + telif riski).

# Araç çıktıları
.pytest_cache/
.ruff_cache/
*.egg-info/
data/raw/**/*.html

# Elle alınmış paylaşım kopyaları — data/gold/ zaten depoda,
# zip bayatlar ve iki ayrı gerçeklik doğar
data/*.zip

# Doğrulama sayfaları CSV'den türetilir (`make altin-dogrulama`), veritabanı
# gerektirmez. Depoda tutulursa CSV düzeltildikçe bayatlar ve etiketleyen
# yanlış sayfaya bakar — aynı "iki ayrı gerçeklik" tuzağı.
data/gold/dogrulama_*.md
